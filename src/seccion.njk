---
layout: base.njk
pagination:
  data: secciones
  size: 1
  alias: s
permalink: "{{ s.clave }}/index.html"
eleventyComputed:
  title: "{{ s.titulo }}"
  resumen: "{{ s.descripcion }}"
---
<div class="contenedor">
  {% set fondo = s.clave | imagenSeccion %}
  {% set lista = collections.recientes | deSeccion(s.clave) %}
  <div class="banner banner--{{ s.variante }} {{ s.tono }} m-{{ s.motivo }}{% if fondo %} con-imagen{% endif %}"{% if fondo %} style="background-image:url('{{ fondo | url }}')"{% endif %}>
    {% if s.variante == "c" %}<span class="banner__fantasma">{{ s.menu }}</span>{% endif %}
    <h1>{{ s.titulo }}</h1><p>{{ s.descripcion }}</p>
  </div>
  {% if not lista.length %}
  <p class="vacio">Todavía no hay artículos en esta sección.</p>
  {% elif s.diseno == "lista" %}
  <div class="lista-noticias">
    {% for a in lista %}
    <a class="noticia revelar" href="{{ a.url | url }}"><small>{{ a.date | fecha }}</small><div><strong>{{ a.data.title }}</strong><span>{{ a.data.resumen }}</span></div></a>
    {% endfor %}
  </div>
  {% elif s.diseno == "revista" %}
  <div class="revista">
    {% for a in lista %}
    <a class="tarjeta {% if loop.first %}tarjeta--grande{% else %}tarjeta--clara{% endif %} revelar" href="{{ a.url | url }}"><small>{{ a.date | fecha }}</small><h3>{{ a.data.title }}</h3><p>{{ a.data.resumen }}</p></a>
    {% endfor %}
  </div>
  {% elif s.diseno == "numerada" %}
  <div class="pasos">
    {% for a in lista %}
    <a class="paso revelar" href="{{ a.url | url }}"><b>{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</b><div><strong>{{ a.data.title }}</strong><span>{{ a.data.resumen }}</span></div></a>
    {% endfor %}
  </div>
  {% else %}
  <div class="listado">
    {% for a in lista %}
    <a class="tarjeta tarjeta--clara revelar" href="{{ a.url | url }}"><small>{{ a.date | fecha }}</small><h3>{{ a.data.title }}</h3><p>{{ a.data.resumen }}</p></a>
    {% endfor %}
  </div>
  {% endif %}
</div>
