---
layout: base.njk
pagination:
  data: secciones
  size: 1
  alias: s
permalink: "{{ s.clave }}/index.html"
eleventyComputed:
  title: "{{ s.titulo }}"
  resumen: "{{ s.descripcion }}"
---
<div class="contenedor">
  {% set fondo = s.clave | imagenSeccion %}
  {% set lista = collections.recientes | deSeccion(s.clave) %}
  <div class="banner banner--{{ s.variante }} {{ s.tono }} m-{{ s.motivo }}{% if fondo %} con-imagen{% endif %}"{% if fondo %} style="background-image:url('{{ fondo | url }}')"{% endif %}>
    {% if s.variante == "c" %}<span class="banner__fantasma">{{ s.menu }}</span>{% endif %}
    <h1>{{ s.titulo }}</h1><p>{{ s.descripcion }}</p>
  </div>
  {% set equipos = lista | equiposDe %}
  {% if equipos.length > 1 %}
  <div class="filtros" id="filtros" role="group" aria-label="Filtrar por equipo">
    <button type="button" class="filtro activo" data-equipo="">Todos</button>
    {% for e in equipos %}<button type="button" class="filtro" data-equipo="{{ e }}">{{ e }}</button>{% endfor %}
  </div>
  {% endif %}
  {% if not lista.length %}
  <p class="vacio">Todavía no hay artículos en esta sección.</p>
  {% elif s.diseno == "lista" %}
  {# Noticias: la más reciente destacada y el resto en un teletipo agrupado por día #}
  {% set lider = lista[0] %}
  <a class="noticia-lider revelar filtrable" data-equipo="{{ lider.data.equipo }}" href="{{ lider.url | url }}">
    <small>{{ lider.date | fecha }}{% if lider.data.equipo %} · {{ lider.data.equipo }}{% endif %}</small>
    <strong>{{ lider.data.title }}</strong>
    <span>{{ lider.data.resumen }}</span>
  </a>
  {% if lista.length > 1 %}
  <div class="teletipo">
    {% for grupo in lista.slice(1) | porDia %}
      <h2 class="teletipo__dia">{{ grupo.dia }}</h2>
      {% for a in grupo.items %}
      <a class="teletipo__item revelar filtrable" data-equipo="{{ a.data.equipo }}" href="{{ a.url | url }}">
        {% if a.data.equipo %}<b class="chip-abr">{{ a.data.equipo | abrev }}</b>{% else %}<b class="chip-abr chip-abr--vacio">NBA</b>{% endif %}
        <div><strong>{{ a.data.title }}</strong><span>{{ a.data.resumen }}</span></div>
      </a>
      {% endfor %}
    {% endfor %}
  </div>
  {% endif %}
  {% elif s.diseno == "revista" %}
  {# Crónicas: cada tarjeta lleva el marcador real del partido si está en los datos de la temporada #}
  <div class="revista">
    {% for a in lista %}
    {% set pt = temporada.partidos | partidoEntre(a.data.equipo_local, a.data.equipo_visitante, a.date) if a.data.equipo_local else null %}
    <a class="tarjeta {% if loop.first %}tarjeta--grande{% else %}tarjeta--clara{% endif %} revelar filtrable" data-equipo="{{ a.data.equipo }}" href="{{ a.url | url }}">
      {% if pt %}<span class="mini-marcador"><b>{{ pt.h }}</b> {{ pt.hs }}<i>-</i>{{ pt.vs }} <b>{{ pt.v }}</b></span>{% endif %}
      <small>{{ a.date | fecha }}</small><h3>{{ a.data.title }}</h3><p>{{ a.data.resumen }}</p>
    </a>
    {% endfor %}
  </div>
  {% elif s.diseno == "numerada" %}
  <div class="pasos">
    {% for a in lista %}
    <a class="paso revelar filtrable" data-equipo="{{ a.data.equipo }}" href="{{ a.url | url }}"><b>{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</b><div><strong>{{ a.data.title }}</strong><span>{{ a.data.resumen }}</span></div></a>
    {% endfor %}
  </div>
  {% else %}
  {# Previas: tarjeta «cara a cara» con las abreviaturas, la hora y el balance actual de cada equipo #}
  <div class="listado listado--previas">
    {% for a in lista %}
    {% set lo = a.data.local or a.data.equipo_local %}{% set vi = a.data.visitante or a.data.equipo_visitante %}
    {% set TL = temporada.porNombre[lo] %}{% set TV = temporada.porNombre[vi] %}
    <a class="previa-tarjeta revelar filtrable" data-equipo="{{ a.data.equipo or lo }}" href="{{ a.url | url }}">
      {% if lo and vi %}
      <span class="previa-tarjeta__duelo">
        <span><b>{{ lo | abrev }}</b>{% if TL and TL.jugados %}<small>{{ TL.v }}-{{ TL.d }}</small>{% endif %}</span>
        <i>vs</i>
        <span><b>{{ vi | abrev }}</b>{% if TV and TV.jugados %}<small>{{ TV.v }}-{{ TV.d }}</small>{% endif %}</span>
      </span>
      {% endif %}
      <small>{{ a.data.fecha_hora or (a.date | fecha) }}</small>
      <h3>{{ a.data.title }}</h3>
    </a>
    {% endfor %}
  </div>
  {% endif %}
</div>
