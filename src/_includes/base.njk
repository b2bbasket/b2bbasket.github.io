<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.nombre }}</title>
<meta name="description" content="{{ resumen or site.descripcion }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Newsreader:wght@600;700;800&display=swap" rel="stylesheet">
<meta name="theme-color" content="#16181D">
<link rel="icon" href="{{ '/img/favicon.svg' | url }}" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="{{ site.nombre }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.nombre }}">
<meta property="og:description" content="{{ resumen or site.descripcion }}">
<meta property="og:image" content="{{ site.url }}/img/og.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="{{ '/css/estilos.css' | url }}">
<script>try{var tm=localStorage.getItem("tema");if(!tm){tm=window.matchMedia("(prefers-color-scheme: dark)").matches?"oscuro":"claro"}document.documentElement.setAttribute("data-tema",tm)}catch(e){}</script>
<script>try{if(sessionStorage.getItem("splash")){document.documentElement.classList.add("splash-visto")}else{sessionStorage.setItem("splash","1")}}catch(e){}</script>
</head>
<body>
<div class="splash" id="splash" aria-hidden="true">
  <svg class="splash__balon" viewBox="0 0 100 100" fill="none" stroke="#FF4B2B" stroke-width="5"><circle cx="50" cy="50" r="44"/><path d="M50 6v88M6 50h88M16 18c22 18 22 46 0 64M84 18c-22 18-22 46 0 64"/></svg>
  <div class="splash__logo">{{ site.nombre }}<span>.</span></div>
  <div class="splash__linea"></div>
  <div class="splash__lema">{{ site.lema }}</div>
</div>
<div class="progreso" id="progreso"></div>
<header class="cabecera" id="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="logo" href="{{ '/' | url }}" aria-label="{{ site.nombre }}">{{ site.abreviatura }}<span>.</span></a>
    <button class="menu-boton" id="menuBoton" aria-label="Abrir menú" aria-expanded="false">Menú</button>
    <nav class="nav" id="nav">
      {% for s in secciones %}<a href="{{ ('/' + s.clave + '/') | url }}">{{ s.menu }}</a>{% endfor %}
      <a href="{{ '/equipos/' | url }}">Equipos</a>
      <a href="{{ '/clasificacion/' | url }}">Clasificación</a>
      <a href="{{ '/lideres/' | url }}">Líderes</a>
      <button type="button" class="tema-boton" id="temaBoton" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro / oscuro"><svg class="luna" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sol" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <div class="buscar-rapido" id="buscarRapido">
        <button type="button" class="buscar-rapido__boton" id="buscarBoton" aria-label="Buscar" aria-expanded="false"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
        <input type="search" id="buscarCampo" placeholder="Buscar en la web..." autocomplete="off" aria-label="Buscar" data-base="{{ '/' | url }}">
        <div class="buscar-rapido__res" id="buscarRes"></div>
      </div>
    </nav>
  </div>
</header>
{% if collections.noticias.length %}
<div class="ticker" aria-label="Últimas noticias">
  <div class="ticker__pista">
    {% for i in [1, 2] %}<span class="ticker__marca">ÚLTIMA HORA</span>{% for a in collections.noticias | limite(6) %}<a href="{{ a.url | url }}">{{ a.data.title }}</a>{% endfor %}{% endfor %}
  </div>
</div>
{% endif %}
<main>
{{ content | safe }}
</main>
<footer class="pie">
  <div class="contenedor">
    <h2 class="pie__titulo">Más información</h2>
    <div class="pie__tarjetas">
      <a href="{{ '/lideres-historicos/' | url }}"><strong>Líderes históricos</strong><span>Top 10 de puntos, rebotes, asistencias, tapones, robos y triples</span></a>
      <a href="{{ '/jugadores/' | url }}"><strong>Grandes jugadores</strong><span>Diez leyendas de la liga y sus curiosidades</span></a>
      <a href="{{ '/historia-de-la-liga/' | url }}"><strong>Historia de la liga</strong><span>Cómo empezó todo y cómo ha cambiado el juego</span></a>
      <div class="pie__medio"><h3>El medio</h3>
        <a href="{{ '/quienes-somos/' | url }}">Quiénes somos</a>
        <a href="{{ '/contacto/' | url }}">Contacto</a>
        <a href="{{ '/juego/' | url }}">Juego diario</a>
        <a href="{{ site.instagram }}">Instagram</a></div>
    </div>
  </div>
  <div class="contenedor pie__legal">
    <a href="{{ '/aviso-legal/' | url }}">Aviso legal</a>
    <a href="{{ '/privacidad/' | url }}">Privacidad</a>
    <a href="{{ '/cookies/' | url }}">Cookies</a>
    <a href="{{ '/condiciones-de-uso/' | url }}">Condiciones de uso</a>
    <a href="{{ '/principios-editoriales/' | url }}">Principios editoriales</a>
    <a href="{{ '/correcciones/' | url }}">Correcciones</a>
    {% if site.banner_cookies %}<a href="#" id="cookiesPreferencias">Preferencias de cookies</a>{% endif %}
    <p>{{ site.nombre }} · {{ site.lema }} Medio independiente, no afiliado a la NBA ni a ninguna franquicia. Los nombres de equipos y jugadores se usan con fines informativos.</p>
  </div>
</footer>
<button class="subir" id="subir" aria-label="Volver arriba"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
{% if site.banner_cookies %}
<div class="cookies" id="cookies" hidden>
  <p>Usamos cookies para analizar el uso de la web y mostrar publicidad. Puedes aceptarlas o rechazarlas. Más información en la <a href="{{ '/cookies/' | url }}">política de cookies</a>.</p>
  <div class="cookies__botones"><button id="cookiesRechazar">Rechazar</button><button id="cookiesAceptar" class="primario">Aceptar</button></div>
</div>
<script src="{{ '/js/cookies.js' | url }}"></script>
{% endif %}
<script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
