<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.nombre }}</title>
<meta name="description" content="{{ resumen or site.descripcion }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Newsreader:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/estilos.css' | url }}">
<script>try{if(sessionStorage.getItem("splash")){document.documentElement.classList.add("splash-visto")}else{sessionStorage.setItem("splash","1")}}catch(e){}</script>
</head>
<body>
<div class="splash" id="splash" aria-hidden="true">
  <svg class="splash__balon" viewBox="0 0 100 100" fill="none" stroke="#FF4B2B" stroke-width="5"><circle cx="50" cy="50" r="44"/><path d="M50 6v88M6 50h88M16 18c22 18 22 46 0 64M84 18c-22 18-22 46 0 64"/></svg>
  <div class="splash__logo">{{ site.nombre }}<span>.</span></div>
  <div class="splash__linea"></div>
  <div class="splash__lema">NBA en español</div>
</div>
<div class="progreso" id="progreso"></div>
<header class="cabecera" id="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="logo" href="{{ '/' | url }}">{{ site.nombre }}<span>.</span></a>
    <button class="menu-boton" id="menuBoton" aria-label="Abrir menú" aria-expanded="false">Menú</button>
    <nav class="nav" id="nav">
      {% for s in secciones %}<a href="{{ ('/' + s.clave + '/') | url }}">{{ s.menu }}</a>{% endfor %}
      <a href="{{ '/equipos/' | url }}">Equipos</a>
    </nav>
  </div>
</header>
{% if collections.recientes.length %}
<div class="ticker" aria-label="Últimas noticias">
  <div class="ticker__pista">
    {% for i in [1, 2] %}<span class="ticker__marca">ÚLTIMA HORA</span>{% for a in collections.recientes | limite(6) %}<a href="{{ a.url | url }}">{{ a.data.title }}</a>{% endfor %}{% endfor %}
  </div>
</div>
{% endif %}
<main>
{{ content | safe }}
</main>
<footer class="pie">
  <div class="contenedor pie__fila">
    <div><a class="logo" href="{{ '/' | url }}">{{ site.nombre }}<span>.</span></a><p>Medio digital independiente sobre la NBA en español.</p></div>
    <div class="pie__enlaces"><a href="{{ '/sobre/' | url }}">Sobre el proyecto</a><a href="{{ '/contacto/' | url }}">Contacto</a><a href="{{ site.instagram }}">Instagram</a></div>
  </div>
</footer>
<button class="subir" id="subir" aria-label="Volver arriba"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
<script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
