---
layout: base.njk
title: "Plantillas NBA"
resumen: "Las plantillas actuales de los 30 equipos de la NBA, con la ficha de cada jugador, actualizadas cada día."
permalink: /plantillas/index.html
---
<div class="contenedor">
  <header class="leyendas-cab">
    <p class="leyendas-cab__kicker">Temporada {{ temporada.temporada or "actual" }}</p>
    <h1>Plantillas de los 30 equipos</h1>
    <p>Elige un equipo para ver su plantilla completa, con la ficha de cada jugador. {{ plantillas.jugadores.length }} jugadores, actualizados cada día.</p>
  </header>
  <div class="plantillas-buscar">
    <input type="search" id="buscarJugador" placeholder="Buscar equipo o jugador..." aria-label="Buscar equipo o jugador" autocomplete="off">
  </div>
  <p class="plantillas-enlace"><a href="{{ '/espanoles-y-latinos/' | url }}">Españoles y latinos en la NBA →</a></p>
  <ul class="plantillas-resultados" id="buscarResultados" hidden aria-live="polite">
    {% for c in plantillas.jugadores %}<li data-nombre="{{ c.nombre | lower }}" hidden><a href="{{ ('/jugador/' + c.slug + '/') | url }}"><b>{{ c.nombre }}</b><span>{{ c.equipo }}{% if c.dorsal %} · #{{ c.dorsal }}{% endif %}</span></a></li>{% endfor %}
  </ul>
  <div class="equipos-tarjetas" id="equiposTarjetas">
    {% for nombre in plantillasEquipos %}
    {% set abr = nombre | abrev %}{% set lista = plantillas | plantillaDe(abr) %}{% set T = temporada.porNombre[nombre] %}
    {% set apodo = nombre | apodo %}
    <a class="equipo-tarjeta" href="{{ ('/plantillas/' + (nombre | slugify) + '/') | url }}" style="--eq:{{ abr | colorEquipo }}" data-nombre="{{ nombre | lower }}">
      <span class="equipo-tarjeta__abr" aria-hidden="true">{{ abr }}</span>
      <span class="equipo-tarjeta__ciudad">{{ nombre | replace(apodo, "") | trim }}</span>
      <strong class="equipo-tarjeta__nombre">{{ apodo }}</strong>
      <span class="equipo-tarjeta__datos">{{ lista.length }} jugadores{% if T and T.jugados %} · {{ T.v }}-{{ T.d }}{% endif %}</span>
    </a>
    {% endfor %}
  </div>
  <p class="nota-fuente">Plantillas de Wikipedia y datos de Wikidata, actualizados el {{ plantillas.actualizado | fechaIso }}. Los colores son los de cada franquicia; no usamos sus escudos porque son marcas registradas.</p>
</div>
<script>
(function () {
  var c = document.getElementById('buscarJugador'), res = document.getElementById('buscarResultados');
  var lim = function (s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
  c.addEventListener('input', function () {
    var q = lim(c.value.trim()), n = 0;
    document.querySelectorAll('.equipo-tarjeta').forEach(function (t) { t.hidden = !!q && lim(t.dataset.nombre).indexOf(q) < 0; });
    res.querySelectorAll('li').forEach(function (li) { var ok = q.length >= 2 && lim(li.dataset.nombre).indexOf(q) > -1 && n < 12; li.hidden = !ok; if (ok) n++; });
    res.hidden = !n;
  });
})();
</script>
