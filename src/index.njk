---
layout: base.njk
permalink: /index.html
---
{% macro icono(k) %}{% if k == "noticias" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="30" cy="62" r="8" fill="currentColor"/><path d="M30 38a24 24 0 0 1 24 24M30 18a44 44 0 0 1 44 44"/><path d="M62 20h26M70 34h18"/></svg>{% elif k == "previas" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="50" cy="54" r="34"/><path d="M50 32v22l14 10M40 12h20M50 12v8"/></svg>{% elif k == "cronicas" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="22" width="80" height="50" rx="8"/><path d="M50 30v34M24 38h12v20H24zM64 38h12v20H64zM30 72v14M70 72v14"/></svg>{% elif k == "guias" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="74" r="9"/><circle cx="70" cy="28" r="9"/><path d="M68 66l14 14M82 66L68 80M22 20l12 12M34 20L22 32"/><path d="M33 68C50 64 54 48 60 36" stroke-dasharray="2 9"/><path d="M53 38l7-3 3 7"/></svg>{% elif k == "equipos" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M36 12c2 8 26 8 28 0l18 8-4 22-10-4v50H32V38l-10 4-4-22z"/><path d="M42 56h16"/></svg>{% elif k == "clasificacion" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M36 88V34h28v54M10 88V54h26M64 88V62h26M6 88h88"/><path d="M50 12l4 8 9 1-6 6 1 9-8-4-8 4 1-9-6-6 9-1z"/></svg>{% elif k == "lideres" %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 30l18 18 18-30 18 30 18-18-8 48H22z"/><path d="M22 88h56"/><circle cx="50" cy="58" r="4" fill="currentColor"/></svg>{% else %}<svg width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5"><circle cx="50" cy="50" r="40"/><path d="M50 10v80M10 50h80M22 22c16 16 16 40 0 56M78 22c-16 16-16 40 0 56"/></svg>{% endif %}{% endmacro %}

{% macro cabecera(titulo, k, extra) %}
<div class="bloque-cab revelar{% if extra %} {{ extra }}{% endif %}">
  <span class="bloque-cab__icono" aria-hidden="true">{% if k == "explora" %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>{% elif k == "resultados" %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="12" rx="2.5"/><path d="M12 7.5v7M6 9h2.5v4H6zM15.5 9H18v4h-2.5zM8 17v3M16 17v3"/></svg>{% else %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>{% endif %}</span>
  <h2 class="seccion__titulo">{{ titulo }}</h2>
  <span class="bloque-cab__regla" aria-hidden="true"></span>
</div>
{% endmacro %}

<section class="contenedor juego-hero-wrap">
  <a class="juego-hero revelar" href="{{ '/juego/' | url }}" aria-label="Juego del día: adivina el jugador misterioso. Jugar ahora">
    <svg class="juego-hero__pista" width="360" height="144" viewBox="0 0 600 240" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M600 20H380v200h220"/><circle cx="380" cy="120" r="46"/><path d="M600 60h-90v120h90"/><path d="M510 120a40 40 0 0 0 0 0"/><circle cx="510" cy="120" r="40" stroke-dasharray="6 8"/><path d="M600 6a230 230 0 0 0 0 228"/></svg>
    <span class="juego-hero__balon" aria-hidden="true"><svg width="84" height="84" viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" fill="#FF4B2B"/><g fill="none" stroke="#16181D" stroke-width="3.5" opacity=".55"><path d="M50 4v92M4 50h92M18 18c17 17 17 47 0 64M82 18c-17 17-17 47 0 64"/></g><circle cx="50" cy="50" r="23" fill="#16181D"/><text x="50" y="62" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-weight="900" font-size="34" fill="#fff">?</text></svg></span>
    <span class="juego-hero__texto">
      <span class="juego-hero__kicker"><i aria-hidden="true"></i>Juego del día</span>
      <strong class="juego-hero__titulo">¿Quién es el jugador misterioso?</strong>
      <span class="juego-hero__sub">Cinco pistas, cinco intentos y un jugador nuevo cada día.</span>
      <span class="juego-hero__pistas" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b><em>5 pistas</em></span>
    </span>
    <span class="juego-hero__accion">
      <span class="juego-hero__estado" id="juegoHeroEstado" hidden></span>
      <span class="juego-hero__cta"><span id="juegoHeroCta">Jugar ahora</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </span>
  </a>
</section>
<script>
(function () {
  try {
    var d = JSON.parse(localStorage.getItem('b2b-juego') || '{}');
    var hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
    var ayer = new Date(Date.parse(hoy + 'T00:00:00Z') - 86400000).toISOString().slice(0, 10);
    var s = d.stats || {};
    var racha = (s.ultimo === hoy || s.ultimo === ayer) ? (s.racha || 0) : 0;
    var partes = [];
    if (d.hoy && d.hoy.dia === hoy && d.hoy.fin) {
      partes.push(d.hoy.acierto ? 'Resuelto hoy ✓' : 'Hoy no hubo suerte');
      document.getElementById('juegoHeroCta').textContent = 'Ver resultado';
    }
    if (racha >= 2) partes.push('🔥 Racha de ' + racha);
    if (partes.length) { var e = document.getElementById('juegoHeroEstado'); e.textContent = partes.join(' · '); e.hidden = false; }
  } catch (err) {}
})();
</script>

<section class="portada contenedor">
  {% if collections.portada.length %}
  <div class="slider revelar" id="slider" tabindex="0" aria-roledescription="carrusel" aria-label="Noticias destacadas">
    <div class="slider__pista" id="sliderPista">
      {% for a in collections.portada | limite(5) %}
      <a class="hero" href="{{ a.url | url }}">
        {% set fotoHero = a.data | fotoArticulo %}
        <div class="hero__fondo"{% if fotoHero %} style="background-image:url('{{ fotoHero.src }}')"{% endif %}></div>
        <div class="hero__texto">
          {% for s in secciones %}{% if s.clave == a.data.seccion %}<span class="etiqueta">{{ s.menu }}</span>{% endif %}{% endfor %}
          <h1 class="hero__titulo">{{ a.data.title }}</h1>
          <p>{{ a.data.resumen }}</p>
          <small>Por {{ a.data.autor or "[Tu nombre]" }} · {{ a.date | fecha }}</small>
        </div>
      </a>
      {% endfor %}
    </div>
    <button class="slider__flecha slider__flecha--izq" id="sliderIzq" aria-label="Anterior"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
    <button class="slider__flecha slider__flecha--der" id="sliderDer" aria-label="Siguiente"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
    <div class="slider__puntos" id="sliderPuntos"></div>
  </div>
  {% endif %}
  <aside class="lateral revelar">
    <h2 class="lateral__titulo">Última hora</h2>
    {% for a in collections.noticias | limite(5) %}
    <a class="item" href="{{ a.url | url }}"><small>{{ a.date | fecha }}</small><strong>{{ a.data.title }}</strong></a>
    {% else %}
    <p class="vacio">Todavía no hay noticias de última hora.</p>
    {% endfor %}
    <a class="insta" href="{{ site.instagram }}">Síguenos en Instagram → {{ site.instagram_usuario }}</a>
  </aside>
</section>

<section class="cifras">
  <div class="contenedor">
    {{ cabecera("Resultados de la jornada", "resultados", "bloque-cab--oscuro") }}
    <p class="cifras__fecha">{{ resultados.fecha }}</p>
    <div class="partidos">
      {% for p in resultados.partidos %}
      {% set crUrl = (p.cronica and ('/articulos/' + p.cronica + '/')) or (collections.recientes | cronicaDe(p)) %}
      {% if crUrl %}<a class="partido partido--enlace revelar" href="{{ crUrl | url }}">{% else %}<div class="partido revelar">{% endif %}
        <span class="eq">{{ p.local }}</span>
        <b data-contar="{{ p.pl }}">0</b><i>-</i><b data-contar="{{ p.pv }}">0</b>
        <span class="eq">{{ p.visitante }}</span>
        {% if crUrl %}<span class="partido__ver">Ver la crónica →</span>{% endif %}
      {% if crUrl %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
    <a class="cifras__calendario" href="{{ '/calendario/' | url }}">Ver el calendario completo <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div>
</section>

<section class="contenedor seccion">
  {{ cabecera("Explora por sección", "explora") }}
  {% set subtitulos = { noticias: "Lo que mueve la liga", previas: "Antes del salto inicial", cronicas: "Lo que pasó en la pista", guias: "Entiende la NBA" } %}
  <div class="explora">
    {% for s in secciones %}
    {% set fondo = s.clave | imagenSeccion %}
    <a class="tile tile--{{ s.clave }}{% if loop.first %} tile--grande{% endif %}{% if fondo %} tile--imagen{% endif %} revelar" href="{{ ('/' + s.clave + '/') | url }}"{% if fondo %} style="background-image:url('{{ fondo | url }}')"{% endif %}>
      <span class="tile__dibujo" aria-hidden="true">{{ icono(s.clave) }}</span>
      <span class="tile__sub">{{ subtitulos[s.clave] or s.titulo }}</span>
      <strong class="tile__nombre">{{ s.menu }}</strong>
      <span class="tile__flecha" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
    {% endfor %}
    {% set extras = [
      { clave: "equipos", url: "/equipos/", nombre: "Equipos", sub: "Las 30 franquicias" },
      { clave: "clasificacion", url: "/clasificacion/", nombre: "Clasificación", sub: "Este y Oeste" },
      { clave: "lideres", url: "/lideres/", nombre: "Líderes", sub: "Los mejores de la temporada" }
    ] %}
    {% for x in extras %}
    {% set fondo = x.clave | imagenSeccion %}
    <a class="tile tile--{{ x.clave }}{% if fondo %} tile--imagen{% endif %} revelar" href="{{ x.url | url }}"{% if fondo %} style="background-image:url('{{ fondo | url }}')"{% endif %}>
      <span class="tile__dibujo" aria-hidden="true">{{ icono(x.clave) }}</span>
      <span class="tile__sub">{{ x.sub }}</span>
      <strong class="tile__nombre">{{ x.nombre }}</strong>
      <span class="tile__flecha" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="contenedor seccion">
  {{ cabecera("Lo último", "ultimo") }}
  {% set colores = ['tarjeta--naranja', 'tarjeta--azul', 'tarjeta--amarilla'] %}
  <div class="rejilla">
    {% for a in collections.portada | limite(3) %}
    <a class="tarjeta {{ colores[loop.index0] }} revelar" href="{{ a.url | url }}"><small>{{ a.date | fecha }}</small><h3>{{ a.data.title }}</h3><p>{{ a.data.resumen }}</p></a>
    {% endfor %}
  </div>
</section>
